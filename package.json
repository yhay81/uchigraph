{
  "name": "uchigraph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "indexnow": "pwsh -NoLogo -NoProfile -File ops/submit-indexnow.ps1 -BaseUrl https://uchigraph.yhay81.com",
    "metrics": "pwsh -NoLogo -NoProfile -File ops/product-metrics.ps1",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "check:fix": "oxlint --fix . && oxfmt --write . && tsc --noEmit",
    "test": "vp test --run --config vitest.config.ts",
    "test:watch": "vp test --config vitest.config.ts",
    "release:check": "pwsh -NoLogo -NoProfile -File ops/validate-product.ps1",
    "deploy": "npm run release:check && npm run check && npm test && npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "4.13.23"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.2",
    "@cloudflare/workers-types": "5.20261127.1",
    "@voidzero-dev/vite-plus-core": "8.3.8001",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0",
    "vitest": "5.1.2",
    "wrangler": "4.168.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "npm@11.16.0"
}
